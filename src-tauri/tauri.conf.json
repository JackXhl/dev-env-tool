{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "项目环境探查",
  "mainBinaryName": "env-probe",
  "version": "0.1.0",
  "identifier": "com.devenvtool.envprobe",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "项目环境探查",
        "width": 1120,
        "height": 760,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": [
      "resources/brand.json",
      "resources/links.json",
      "resources/links.local.json.example",
      "resources/probe-roots.json"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ]
  }
}
